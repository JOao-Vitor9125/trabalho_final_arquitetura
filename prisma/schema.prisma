// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model rents{
  id String  @id @default(uuid())
  userId String
  carId String
  startDate DateTime @default(now())
  endDate  DateTime?
  car_placa String 
  car cars @relation(fields:[car_placa], references:[placa])
}

model cars{
  placa String  @id
  ano Int 
  cor String
  rented  Boolean
  rent rents[]
}


